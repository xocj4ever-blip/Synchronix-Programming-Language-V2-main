// ============================================================================
// SYNCHRONIX v2.0.0 — Portable ABI, Pointer, C-String & OS Abstraction Layer
// (include/portable_asm.synchronix)
// ============================================================================
// Pure Synchronix 1-to-1 replacement for V1's include/portable_asm.S:
//   - Canonical portable ABI metadata (4 arg regs, 5 callee-saved regs)
//   - Safe pointer read/write primitives (8-bit & 64-bit) & argv indexing
//   - Dynamic NUL-terminated C-string builders & comparisons
//   - Cross-platform OS filesystem & environment helpers
// ============================================================================

extern func sx_closure_alloc(fn_ptr: Int, cap: Int) -> Int;
extern func sx_closure_set_env(buf: Int, idx: Int, value: Int) -> Int;
extern func sx_closure_get_env(buf: Int, idx: Int) -> Int;
extern func sx_arc_release(buf: Int) -> Int;

extern func calloc(nmemb: Int, size: Int) -> Int;
extern func free(ptr: Int) -> Int;
extern func memcpy(dst: Int, src: Int, n: Int) -> Int;
extern func strlen(s: Int) -> Int;
extern func strcmp(a: Int, b: Int) -> Int;
extern func strcpy(dst: Int, src: Int) -> Int;
extern func strcat(dst: Int, src: Int) -> Int;
extern func strstr(haystack: Int, needle: Int) -> Int;
extern func getenv(name: Int) -> Int;
extern func fopen(path: Int, mode: Int) -> Int;
extern func fclose(fp: Int) -> Int;
extern func remove(path: Int) -> Int;
extern func _mkdir(path: Int) -> Int;
extern func _rmdir(path: Int) -> Int;

// Static Phi ABI invariants (matching V1 portable_asm.S register contract)
phi portable_abi_arg_regs    = 4 == 4
phi portable_abi_callee_regs = 5 == 5
phi portable_abi_word_bytes  = 8 == 8

func SX_ABI_ARG_REGS()    -> Int { return 4 }
func SX_ABI_CALLEE_REGS() -> Int { return 5 }
func SX_ABI_WORD_BYTES()  -> Int { return 8 }

// ----------------------------------------------------------------------------
// Portable Pointer & Byte Memory Primitives (Little-Endian x86_64 & ARM64)
// ----------------------------------------------------------------------------
func sx_ptr_read64(addr: Int) -> Int {
    if addr == 0 {
        return 0
    }
    let box = sx_closure_alloc(0, 1)
    memcpy(box + 16, addr, 8)
    let v = sx_closure_get_env(box, 0)
    sx_arc_release(box)
    return v
}

func sx_ptr_write64(addr: Int, value: Int) -> Int {
    if addr == 0 {
        return 0
    }
    let box = sx_closure_alloc(0, 1)
    sx_closure_set_env(box, 0, value)
    memcpy(addr, box + 16, 8)
    sx_arc_release(box)
    return value
}

func sx_ptr_read8(addr: Int) -> Int {
    if addr == 0 {
        return 0
    }
    let box = sx_closure_alloc(0, 1)
    sx_closure_set_env(box, 0, 0)
    memcpy(box + 16, addr, 1)
    let v = sx_closure_get_env(box, 0)
    sx_arc_release(box)
    return v
}

func sx_ptr_write8(addr: Int, byte_val: Int) -> Int {
    if addr == 0 {
        return 0
    }
    let box = sx_closure_alloc(0, 1)
    sx_closure_set_env(box, 0, byte_val)
    memcpy(addr, box + 16, 1)
    sx_arc_release(box)
    return byte_val
}

func sx_argv_get(argv: Int, idx: Int) -> Int {
    if argv == 0 || idx < 0 {
        return 0
    }
    let ptr = sx_ptr_read64(argv + idx * 8)
    return ptr
}

// ----------------------------------------------------------------------------
// Dynamic C-String Buffer Builders & Comparisons
// ----------------------------------------------------------------------------
func sx_cstr_alloc(bytes: Int) -> Int
    requires bytes > 0
{
    let p = calloc(1, bytes)
    return p
}

func sx_cstr_free(ptr: Int) -> Int {
    if ptr != 0 {
        free(ptr)
    }
    return 0
}

func sx_cstr_copy(dst: Int, src: Int) -> Int {
    if dst == 0 || src == 0 {
        return 0
    }
    strcpy(dst, src)
    return dst
}

func sx_cstr_cat(dst: Int, src: Int) -> Int {
    if dst == 0 || src == 0 {
        return 0
    }
    strcat(dst, src)
    return dst
}

func sx_cstr_cat_char(dst: Int, ch: Int) -> Int {
    if dst == 0 {
        return 0
    }
    let n = strlen(dst)
    sx_ptr_write8(dst + n, ch)
    sx_ptr_write8(dst + n + 1, 0)
    return n + 1
}

func sx_cstr_cat_quote(dst: Int) -> Int {
    let n = sx_cstr_cat_char(dst, 34)
    return n
}

func sx_cstr_cat_quoted(dst: Int, text: Int) -> Int {
    sx_cstr_cat_quote(dst)
    sx_cstr_cat(dst, text)
    sx_cstr_cat_quote(dst)
    return dst
}

func sx_cstr_eq(a: Int, b: Int) -> Int {
    if a == 0 || b == 0 {
        return 0
    }
    let r = strcmp(a, b)
    if r == 0 {
        return 1
    }
    return 0
}

func sx_cstr_len(s: Int) -> Int {
    if s == 0 {
        return 0
    }
    let n = strlen(s)
    return n
}

func sx_cstr_contains(haystack: Int, needle: Int) -> Int {
    if haystack == 0 || needle == 0 {
        return 0
    }
    let hit = strstr(haystack, needle)
    if hit != 0 {
        return 1
    }
    return 0
}

func sx_cstr_is_empty(s: Int) -> Int {
    if s == 0 {
        return 1
    }
    let ch = sx_ptr_read8(s)
    if ch == 0 {
        return 1
    }
    return 0
}

// ----------------------------------------------------------------------------
// Cross-Platform Environment & Filesystem Helpers
// ----------------------------------------------------------------------------
func sx_env_or_default(env_name: String, def_val: String) -> Int {
    let v = getenv(env_name)
    if v != 0 {
        let ch = sx_ptr_read8(v)
        if ch != 0 {
            return v
        }
    }
    return def_val
}

func sx_file_exists(path: Int) -> Int {
    if path == 0 {
        return 0
    }
    let fp = fopen(path, "rb")
    if fp != 0 {
        fclose(fp)
        return 1
    }
    return 0
}

func sx_os_mkdir(dir_path: Int) -> Int {
    if dir_path == 0 {
        return 0
    }
    _mkdir(dir_path)
    return 0
}

func sx_os_rmdir(dir_path: Int) -> Int {
    if dir_path == 0 {
        return 0
    }
    _rmdir(dir_path)
    return 0
}

func sx_os_remove(file_path: Int) -> Int {
    if file_path == 0 {
        return 0
    }
    remove(file_path)
    return 0
}
