// ============================================================================
// SYNCHRONIX v2.0.0 — Ecosystem: Cargo Package Manager & Build System
// (src/tooling/cargo_pkg.synchronix)
// ============================================================================
// Full V1-parity Pure Synchronix Package Manager (1-to-1 with V1 cargo_pkg.S):
//   - sx_cmd_new(name)           : scaffolds <name>/Synchronix.toml + <name>/src/main.synchronix
//   - sx_cmd_build(ctx, src, out): verifies Synchronix.toml & compiles native binary
//   - sx_cmd_run(ctx, src)       : builds & executes native binary
//   - sx_cmd_test(ctx, src)      : compiles, verifies Phi proofs & runs test binary
// ============================================================================

import sx_defs
import portable_asm
import utils
import emitter

extern func fputs(s: Int, fp: Int) -> Int;
extern func system(cmd: Int) -> Int;
extern func sx_print_str(s: Int) -> Int;
extern func sx_println_str(s: Int) -> Int;

phi cargo_edition_year = 2026 >= 2026

func sx_write_manifest(fp: Int, proj_name: Int) -> Int {
    fputs("[package]\nname = ", fp)
    fputc(34, fp)
    fputs(proj_name, fp)
    fputc(34, fp)
    fputs("\nversion = ", fp)
    fputc(34, fp); fputs("0.2.0", fp); fputc(34, fp)
    fputs("\nedition = ", fp)
    fputc(34, fp); fputs("2026", fp); fputc(34, fp)
    fputs("\ncompiler = ", fp)
    fputc(34, fp); fputs("synchronix-v2-self-hosted", fp); fputc(34, fp)
    fputs("\nmemory_model = ", fp)
    fputc(34, fp); fputs("unified-arc-gc", fp); fputc(34, fp)
    fputs("\n\n[dependencies]\nstd = ", fp)
    fputc(34, fp); fputs("2.0", fp); fputc(34, fp)
    fputc(10, fp)
    return 0
}

func sx_write_starter_main(fp: Int) -> Int {
    fputs("// Synchronix v2.0.0 Project - Generated by `synchronix new`\n", fp)
    fputs("func main() -> Int {\n", fp)
    fputs("    let msg = ", fp)
    fputc(34, fp)
    fputs("Hello from Synchronix v2 (100% Pure Synchronix)!", fp)
    fputc(34, fp)
    fputs("\n    println(msg)\n", fp)
    fputs("    let box = arc(42)\n", fp)
    fputs("    val managed = gc(100)\n", fp)
    fputs("    prove 2 + 2 == 4\n", fp)
    fputs("    println(box + managed)\n", fp)
    fputs("    mem_stats()\n", fp)
    fputs("    return 0\n", fp)
    fputs("}\n", fp)
    return 0
}

// ----------------------------------------------------------------------------
// sx_cmd_new(proj_name) -> scaffolds <name>/Synchronix.toml & <name>/src/main.synchronix
// ----------------------------------------------------------------------------
func sx_cmd_new(proj_name: Int) -> Int {
    let dir_src = sx_cstr_alloc(512)
    let p_toml = sx_cstr_alloc(512)
    let p_main = sx_cstr_alloc(512)

    sx_os_mkdir(proj_name)
    sx_cstr_copy(dir_src, proj_name)
    sx_cstr_cat(dir_src, "/src")
    sx_os_mkdir(dir_src)

    sx_cstr_copy(p_toml, proj_name)
    sx_cstr_cat(p_toml, "/Synchronix.toml")
    let f_toml = fopen(p_toml, "w")
    if f_toml == 0 {
        println("[Synchronix Cargo] Error: cannot create Synchronix.toml")
        sx_cstr_free(dir_src)
        sx_cstr_free(p_toml)
        sx_cstr_free(p_main)
        return 1
    }
    sx_write_manifest(f_toml, proj_name)
    fclose(f_toml)

    sx_cstr_copy(p_main, proj_name)
    sx_cstr_cat(p_main, "/src/main.synchronix")
    let f_main = fopen(p_main, "w")
    if f_main == 0 {
        println("[Synchronix Cargo] Error: cannot create src/main.synchronix")
        sx_cstr_free(dir_src)
        sx_cstr_free(p_toml)
        sx_cstr_free(p_main)
        return 1
    }
    sx_write_starter_main(f_main)
    fclose(f_main)

    print("[Synchronix Cargo] Created package '")
    sx_print_str(proj_name)
    println("' (Synchronix.toml + src/main.synchronix)")

    sx_cstr_free(dir_src)
    sx_cstr_free(p_toml)
    sx_cstr_free(p_main)
    return 0
}

// ----------------------------------------------------------------------------
// sx_cmd_build(ctx, optional_src_or_0, optional_out_or_0)
// ----------------------------------------------------------------------------
func sx_cmd_build(ctx: Int, src_in: Int, out_in: Int) -> Int {
    var src_path = src_in
    var out_path = out_in

    if src_path == 0 {
        if sx_file_exists("Synchronix.toml") == 0 {
            println("[Synchronix Cargo] Error: Synchronix.toml not found in current directory.")
            return 1
        }
        src_path = "src/main.synchronix"
    }
    if out_path == 0 {
        out_path = "synchronix_app.exe"
    }

    let rc = sx_compile_file(ctx, src_path, out_path)
    if rc == 0 {
        print("[Synchronix Cargo] Build succeeded -> ")
        sx_println_str(out_path)
    }
    return rc
}

// ----------------------------------------------------------------------------
// sx_cmd_run(ctx, optional_src_or_0) -> builds & executes native binary
// ----------------------------------------------------------------------------
func sx_cmd_run(ctx: Int, src_in: Int) -> Int {
    let brc = sx_cmd_build(ctx, src_in, "synchronix_app.exe")
    if brc != 0 {
        return brc
    }
    println("[Synchronix Cargo] Running synchronix_app.exe...")
    let cmd = sx_cstr_alloc(512)
    sx_cstr_cat_quoted(cmd, "synchronix_app.exe")
    let rc = system(cmd)
    sx_cstr_free(cmd)
    return rc
}

// ----------------------------------------------------------------------------
// sx_cmd_test(ctx, optional_src_or_0) -> runs Phi verification & executes tests
// ----------------------------------------------------------------------------
func sx_cmd_test(ctx: Int, src_in: Int) -> Int {
    let rc = sx_cmd_run(ctx, src_in)
    if rc == 0 {
        println("[Synchronix Cargo] All Phi formal proofs & runtime tests PASSED!")
    }
    return rc
}
