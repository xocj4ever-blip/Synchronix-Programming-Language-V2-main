// ============================================================================
// SYNCHRONIX v2.0.0 — Ecosystem: Debugger (LLDB/GDB) & 3-Phase Profiler
// (src/tooling/debug_prof.synchronix)
// ============================================================================
// Full V1-parity Pure Synchronix Debugger & Profiler (1-to-1 with debug_prof.S):
//   - sx_cmd_debug(ctx, file)   : compiles with -g DWARF info & launches LLDB
//   - sx_cmd_profile(ctx, file) : times compile + native execution & prints
//     complete 3-Phase compiler optimization & runtime profiling telemetry!
// ============================================================================

import sx_defs
import portable_asm
import utils
import emitter
import stdlib

extern func system(cmd: Int) -> Int;

phi prof_phases_tracked = 3 == 3

// ----------------------------------------------------------------------------
// sx_cmd_debug(ctx, src_path) — Compile with DWARF -g & invoke LLDB
// ----------------------------------------------------------------------------
func sx_cmd_debug(ctx: Int, src_path: Int) -> Int {
    sx_ctx_set(ctx, CTX_OPT_DEBUG(), 1)
    let rc = sx_compile_file(ctx, src_path, "synchronix_debug.exe")
    if rc != 0 {
        return 1
    }
    println("[Synchronix Debugger] Built debug binary with DWARF symbols -> synchronix_debug.exe")
    println("[Synchronix Debugger] Launching LLDB session...")

    let cmd = sx_cstr_alloc(512)
    sx_cstr_copy(cmd, "lldb -b -o ")
    sx_cstr_cat_quoted(cmd, "b main")
    sx_cstr_cat(cmd, " -o ")
    sx_cstr_cat_quoted(cmd, "run")
    sx_cstr_cat(cmd, " ")
    sx_cstr_cat_quoted(cmd, "synchronix_debug.exe")
    system(cmd)
    sx_cstr_free(cmd)
    return 0
}

// ----------------------------------------------------------------------------
// sx_cmd_profile(ctx, src_path) — Full Compiler + Native Runtime Profiler
// ----------------------------------------------------------------------------
func sx_cmd_profile(ctx: Int, src_path: Int) -> Int {
    // 1. Measure full 3-phase compilation time
    let t0 = std_clock_ticks()
    let rc = sx_compile_file(ctx, src_path, "synchronix_prof.exe")
    if rc != 0 {
        return 1
    }
    let t1 = std_clock_ticks()
    let comp_ticks = t1 - t0

    // 2. Measure native binary execution time
    let cmd = sx_cstr_alloc(256)
    sx_cstr_cat_quoted(cmd, "synchronix_prof.exe")
    let e0 = std_clock_ticks()
    system(cmd)
    let e1 = std_clock_ticks()
    let exec_ticks = e1 - e0
    sx_cstr_free(cmd)

    // 3. Print complete structured 3-Phase Profiler Report (matching V1)
    let toks  = sx_ctx_get(ctx, CTX_TOK_COUNT())
    let asts  = sx_ctx_get(ctx, CTX_AST_COUNT())
    let lams  = sx_ctx_get(ctx, CTX_LAMBDA_COUNT())
    let pstat = sx_ctx_get(ctx, CTX_STAT_PHI_STAT())
    let prt   = sx_ctx_get(ctx, CTX_STAT_PHI_RT())
    let irs   = sx_ctx_get(ctx, CTX_IR_COUNT())
    let arcs  = sx_ctx_get(ctx, CTX_STAT_ARC_INS())
    let gcr   = sx_ctx_get(ctx, CTX_STAT_GC_ROOTS())
    let cf    = sx_ctx_get(ctx, CTX_STAT_CFOLD())
    let dce   = sx_ctx_get(ctx, CTX_STAT_DCE())
    let inl   = sx_ctx_get(ctx, CTX_STAT_INLINED())
    let rega  = sx_ctx_get(ctx, CTX_STAT_REGALLOC())
    let sch   = sx_ctx_get(ctx, CTX_STAT_SCHED())

    println("")
    println("================ SYNCHRONIX PROFILER REPORT ================")
    print("  Compile Time     : "); print(comp_ticks); println(" ticks")
    print("  Execution Time   : "); print(exec_ticks); println(" ticks")
    print("  Phase 1 Frontend : tokens="); print(toks)
    print(" ast_nodes="); print(asts)
    print(" lambdas="); println(lams)
    print("  Phi Verification : static_proven="); print(pstat)
    print(" runtime_checks="); println(prt)
    print("  Phase 2 Middle   : sumir_insts="); print(irs)
    print(" arc_ops="); print(arcs)
    print(" gc_roots="); println(gcr)
    print("  Phase 2 Lowering : const_folded="); print(cf)
    print(" dce_removed="); print(dce)
    print(" inlined="); println(inl)
    print("  Phase 3 Backend  : reg_allocated="); print(rega)
    print(" sched_opts="); println(sch)
    println("============================================================")
    return 0
}
