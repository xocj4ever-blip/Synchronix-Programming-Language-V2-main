// ============================================================================
// SYNCHRONIX v2.0.0 — Phase 3: Full 3-Phase Pipeline, Assembler & Linker Driver
// (src/backend/emitter.synchronix)
// ============================================================================
// Full V1-parity Pure Synchronix Pipeline Driver (1-to-1 with V1 emitter.S):
//   Phase 1 (Frontend)   : Read -> Lexer -> Parser -> Sema + Phi + Lambda
//   Phase 2 (Middle-End) : SUMIR -> Ownership/ARC/GC -> Phi/Lambda Opt -> Lowering
//   Phase 3 (Backend)    : RegAlloc -> Scheduling -> x86_64/ARM64/LLVM IR
//                          + Assembler & Linker (clang/lld) + Runtime + Ext Libs
// ============================================================================

import sx_defs
import portable_asm
import utils
import lexer
import parser
import sema
import ir_gen
import lowering
import target_opt
import codegen

extern func system(cmd: Int) -> Int;
extern func sx_print_str(s: Int) -> Int;
extern func sx_println_str(s: Int) -> Int;

phi emitter_phases_count = 3 == 3

// ----------------------------------------------------------------------------
// Locate Synchronix Runtime Archive (build/libsynchronix_rt.a or local)
// ----------------------------------------------------------------------------
func sx_find_rt_lib() -> Int {
    if sx_file_exists("build/libsynchronix_rt.a") != 0 {
        return "build/libsynchronix_rt.a"
    }
    return "libsynchronix_rt.a"
}

// ----------------------------------------------------------------------------
// Native Linker & Cross-Assembler Drivers (x86_64 LLD & ARM64 AArch64)
// ----------------------------------------------------------------------------
func sx_link_x86_64(ctx: Int, asm_path: Int, out_path: Int) -> Int {
    let rt_lib = sx_find_rt_lib()
    let dbg = sx_ctx_get(ctx, CTX_OPT_DEBUG())
    let ext_lib = sx_ctx_get(ctx, CTX_OPT_EXT_LIB())

    let cmd = sx_cstr_alloc(2048)
    sx_cstr_copy(cmd, "clang -fuse-ld=lld")
    if dbg != 0 {
        sx_cstr_cat(cmd, " -g")
    }
    sx_cstr_cat(cmd, " ")
    sx_cstr_cat_quoted(cmd, asm_path)
    sx_cstr_cat(cmd, " ")
    sx_cstr_cat_quoted(cmd, rt_lib)

    if ext_lib != 0 {
        sx_cstr_cat(cmd, " ")
        sx_cstr_cat_quoted(cmd, ext_lib)
    }

    sx_cstr_cat(cmd, " -o ")
    sx_cstr_cat_quoted(cmd, out_path)

    let rc = system(cmd)
    sx_cstr_free(cmd)

    if rc != 0 {
        print("[Synchronix Error] Assembler/Linker failed (exit=")
        print(rc)
        println(").")
        return 1
    }
    print("[Synchronix Backend] Linked native executable: ")
    sx_println_str(out_path)
    return 0
}

func sx_assemble_arm64(asm_path: Int, out_path: Int) -> Int {
    let obj_path = sx_cstr_alloc(512)
    sx_cstr_copy(obj_path, out_path)
    sx_cstr_cat(obj_path, ".o")

    let cmd = sx_cstr_alloc(2048)
    sx_cstr_copy(cmd, "clang --target=aarch64-w64-windows-gnu -c ")
    sx_cstr_cat_quoted(cmd, asm_path)
    sx_cstr_cat(cmd, " -o ")
    sx_cstr_cat_quoted(cmd, obj_path)

    let rc = system(cmd)
    sx_cstr_free(cmd)

    if rc != 0 {
        sx_cstr_free(obj_path)
        print("[Synchronix Error] ARM64 Assembler failed (exit=")
        print(rc)
        println(").")
        return 1
    }
    print("[Synchronix Backend] Assembled ARM64 object: ")
    sx_println_str(obj_path)
    sx_cstr_free(obj_path)
    return 0
}

// ----------------------------------------------------------------------------
// sx_compile_file(ctx, src_path, out_path) -> 0 on success else 1
// Matches V1 emitter.S behavior: appends .s / .ll and invokes clang/lld unless
// --emit-asm is set!
// ----------------------------------------------------------------------------
func sx_compile_file(ctx: Int, src_path: Int, out_path: Int) -> Int {
    sx_ctx_reset(ctx)

    // --- PHASE 1: FRONTEND (ANALYSIS) ---
    let nbytes = sx_read_source_file(ctx, src_path)
    if nbytes < 0 {
        print("[Synchronix Error] Cannot open source file: ")
        sx_println_str(src_path)
        return 1
    }

    sx_lex(ctx)
    let root = sx_parse_program(ctx)
    let sema_errs = sx_sema_program(ctx, root)
    if sema_errs > 0 {
        print("[Synchronix] Compilation aborted with ")
        print(sema_errs)
        println(" error(s).")
        return 1
    }

    // --- PHASE 2: MIDDLE-END (OPTIMIZATION & MEMORY) ---
    sx_ir_gen_program(ctx, root)
    sx_middle_end_run(ctx)

    let total_errs = sx_ctx_get(ctx, CTX_ERR_COUNT())
    if total_errs > 0 {
        print("[Synchronix] Compilation aborted with ")
        print(total_errs)
        println(" error(s).")
        return 1
    }

    // --- PHASE 3: BACKEND (TARGET OPT + CODEGEN + ASSEMBLER/LINKER) ---
    sx_pass_regalloc(ctx)
    sx_pass_inst_schedule(ctx)

    let tgt = sx_ctx_get(ctx, CTX_OPT_TARGET())
    let emit_asm = sx_ctx_get(ctx, CTX_OPT_EMIT_ASM())

    if tgt == TARGET_LLVM_IR() {
        let ll_path = sx_cstr_alloc(512)
        sx_cstr_copy(ll_path, out_path)
        sx_cstr_cat(ll_path, ".ll")
        let fp_ll = fopen(ll_path, "w")
        if fp_ll == 0 {
            print("[Synchronix Error] Cannot open output file: ")
            sx_println_str(ll_path)
            sx_cstr_free(ll_path)
            return 1
        }
        sx_codegen_llvm(ctx, fp_ll)
        fclose(fp_ll)
        print("[Synchronix Backend] Emitted LLVM IR: ")
        sx_println_str(ll_path)
        sx_cstr_free(ll_path)
        return 0
    }

    let asm_path = sx_cstr_alloc(512)
    sx_cstr_copy(asm_path, out_path)
    sx_cstr_cat(asm_path, ".s")

    let fp = fopen(asm_path, "w")
    if fp == 0 {
        print("[Synchronix Error] Cannot open output file: ")
        sx_println_str(asm_path)
        sx_cstr_free(asm_path)
        return 1
    }

    if tgt == TARGET_ARM64() {
        sx_codegen_arm64(ctx, fp)
        fclose(fp)
        if emit_asm != 0 {
            sx_cstr_free(asm_path)
            return 0
        }
        let a_rc = sx_assemble_arm64(asm_path, out_path)
        sx_cstr_free(asm_path)
        return a_rc
    }

    // Default: Custom x86_64 Code Generator
    sx_codegen_x86_64(ctx, fp)
    fclose(fp)

    if emit_asm != 0 {
        sx_cstr_free(asm_path)
        return 0
    }

    let x_rc = sx_link_x86_64(ctx, asm_path, out_path)
    sx_cstr_free(asm_path)
    return x_rc
}
