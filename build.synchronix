// ============================================================================
// SYNCHRONIX v2.0.0 — Pure Synchronix Build System & Cross-Target Verifier
// (build.synchronix)
// ============================================================================
// Full V1-parity Pure Synchronix replacement for V1's build.S!
// Supports:
//   - CLI targets: (default)=all+verify, all, build, runtime, compiler,
//                  verify, clean, --no-verify, help / --help / -h
//   - Environment overrides: CC (clang), AR (llvm-ar), SX (build/synchronix.exe),
//                            CFLAGS, LDFLAGS (-fuse-ld=lld)
//   - Automatic project root detection (., .., argv[0])
//   - Self-hosted compilation of all 22 pure .synchronix units + native link
//   - Cross-target verification across x86_64 & ARM64 (AArch64)
//   - Native `clean` removing generated build artifacts
// ============================================================================

import portable_asm

extern func system(cmd: Int) -> Int;
extern func sx_print_str(s: Int) -> Int;
extern func sx_println_str(s: Int) -> Int;

phi build_v2_unit_count = (2 + 4 + 4 + 3 + 4 + 4 + 1) == 22

// Action bitmask flags (matching V1 build.S)
func ACT_RUNTIME()  -> Int { return 1 }
func ACT_COMPILER() -> Int { return 2 }
func ACT_VERIFY()   -> Int { return 4 }
func ACT_CLEAN()    -> Int { return 8 }
func ACT_HELP()     -> Int { return 16 }

// Build state handle slots (16 slots via ARC slot buffer)
func BST_CC()       -> Int { return 0 }
func BST_AR()       -> Int { return 1 }
func BST_SX()       -> Int { return 2 }
func BST_CFLAGS()   -> Int { return 3 }
func BST_LDFLAGS()  -> Int { return 4 }
func BST_ROOT()     -> Int { return 5 }
func BST_BLD()      -> Int { return 6 }
func BST_XVER()     -> Int { return 7 }
func BST_EXE()      -> Int { return 8 }
func BST_RT()       -> Int { return 9 }
func BST_LINK_CMD() -> Int { return 10 }

func bld_get(st: Int, slot: Int) -> Int {
    return sx_closure_get_env(st, slot)
}

func bld_set(st: Int, slot: Int, v: Int) -> Int {
    sx_closure_set_env(st, slot, v)
    return v
}

// ----------------------------------------------------------------------------
// Help Banner
// ----------------------------------------------------------------------------
func sx_build_help() -> Int {
    println("SYNCHRONIX v2.0.0 Pure Synchronix Build System (build.synchronix)")
    println("")
    println("Usage: sx_build [target]")
    println("  (default)   Build compiler + cross-target verification")
    println("  all         Build self-hosted compiler (build/synchronix.exe)")
    println("  build       Alias for 'all'")
    println("  runtime     Compile all 4 pure .synchronix runtime units")
    println("  compiler    Compile & link build/synchronix.exe from all 22 .synchronix units")
    println("  verify      Build all & cross-verify units for x86_64 and ARM64 (AArch64)")
    println("  clean       Remove generated .s, .o, cross_verify/, and build artifacts")
    println("  --no-verify Skip cross-target verification step")
    println("  help        Show this message")
    println("")
    println("Environment overrides: CC (clang), AR (llvm-ar), SX (build/synchronix.exe), CFLAGS, LDFLAGS (-fuse-ld=lld)")
    return 0
}

// ----------------------------------------------------------------------------
// Root Directory Detection & Path Construction (matching V1 build.S)
// ----------------------------------------------------------------------------
func sx_probe_root(dir: Int) -> Int {
    let p = sx_cstr_alloc(1024)
    sx_cstr_copy(p, dir)
    sx_cstr_cat(p, "/include/sx_defs.synchronix")
    let ok = sx_file_exists(p)
    sx_cstr_free(p)
    return ok
}

func sx_strip_component(buf: Int) -> Int {
    var n = sx_cstr_len(buf)
    while n > 0 {
        n = n - 1
        let ch = sx_ptr_read8(buf + n)
        if ch == 47 || ch == 92 {
            sx_ptr_write8(buf + n, 0)
            return 1
        }
    }
    return 0
}

func sx_detect_root(st: Int, argv0: Int) -> Int {
    let root = sx_cstr_alloc(1024)
    var found = 0

    if sx_probe_root(".") != 0 {
        sx_cstr_copy(root, ".")
        found = 1
    }
    if found == 0 && sx_probe_root("..") != 0 {
        sx_cstr_copy(root, "..")
        found = 1
    }
    if found == 0 && argv0 != 0 {
        sx_cstr_copy(root, argv0)
        if sx_strip_component(root) != 0 {
            if sx_probe_root(root) != 0 {
                found = 1
            } else {
                if sx_strip_component(root) != 0 {
                    if sx_probe_root(root) != 0 {
                        found = 1
                    }
                }
            }
        }
    }
    if found == 0 {
        sx_cstr_copy(root, ".")
    }

    let bld = sx_cstr_alloc(1024)
    sx_cstr_copy(bld, root); sx_cstr_cat(bld, "/build")

    let xver = sx_cstr_alloc(1024)
    sx_cstr_copy(xver, root); sx_cstr_cat(xver, "/build/cross_verify")

    let exe = sx_cstr_alloc(1024)
    sx_cstr_copy(exe, root); sx_cstr_cat(exe, "\\build\\synchronix.exe")

    let rt = sx_cstr_alloc(1024)
    sx_cstr_copy(rt, root); sx_cstr_cat(rt, "/build/libsynchronix_rt.a")

    bld_set(st, BST_ROOT(), root)
    bld_set(st, BST_BLD(), bld)
    bld_set(st, BST_XVER(), xver)
    bld_set(st, BST_EXE(), exe)
    bld_set(st, BST_RT(), rt)
    return 0
}

// ----------------------------------------------------------------------------
// Unit Table (all 22 pure .synchronix compiler/runtime/tooling units)
// ----------------------------------------------------------------------------
func sx_unit_src(idx: Int) -> Int {
    if idx == 0  { return "include/portable_asm.synchronix" }
    if idx == 1  { return "include/sx_defs.synchronix" }
    if idx == 2  { return "src/frontend/utils.synchronix" }
    if idx == 3  { return "src/frontend/lexer.synchronix" }
    if idx == 4  { return "src/frontend/parser.synchronix" }
    if idx == 5  { return "src/frontend/sema.synchronix" }
    if idx == 6  { return "src/middle/ir_gen.synchronix" }
    if idx == 7  { return "src/middle/mem_safety.synchronix" }
    if idx == 8  { return "src/middle/phi_lambda_opt.synchronix" }
    if idx == 9  { return "src/middle/lowering.synchronix" }
    if idx == 10 { return "src/backend/target_opt.synchronix" }
    if idx == 11 { return "src/backend/codegen.synchronix" }
    if idx == 12 { return "src/backend/emitter.synchronix" }
    if idx == 13 { return "src/runtime/memory_rt.synchronix" }
    if idx == 14 { return "src/runtime/async_rt.synchronix" }
    if idx == 15 { return "src/runtime/phi_lambda_rt.synchronix" }
    if idx == 16 { return "src/runtime/stdlib.synchronix" }
    if idx == 17 { return "src/tooling/cargo_pkg.synchronix" }
    if idx == 18 { return "src/tooling/fmt_lint.synchronix" }
    if idx == 19 { return "src/tooling/lsp.synchronix" }
    if idx == 20 { return "src/tooling/debug_prof.synchronix" }
    if idx == 21 { return "src/main.synchronix" }
    return 0
}

func sx_unit_stem(idx: Int) -> Int {
    if idx == 0  { return "portable_asm" }
    if idx == 1  { return "sx_defs" }
    if idx == 2  { return "utils" }
    if idx == 3  { return "lexer" }
    if idx == 4  { return "parser" }
    if idx == 5  { return "sema" }
    if idx == 6  { return "ir_gen" }
    if idx == 7  { return "mem_safety" }
    if idx == 8  { return "phi_lambda_opt" }
    if idx == 9  { return "lowering" }
    if idx == 10 { return "target_opt" }
    if idx == 11 { return "codegen" }
    if idx == 12 { return "emitter" }
    if idx == 13 { return "memory_rt" }
    if idx == 14 { return "async_rt" }
    if idx == 15 { return "phi_lambda_rt" }
    if idx == 16 { return "stdlib" }
    if idx == 17 { return "cargo_pkg" }
    if idx == 18 { return "fmt_lint" }
    if idx == 19 { return "lsp" }
    if idx == 20 { return "debug_prof" }
    if idx == 21 { return "main" }
    return 0
}

// ----------------------------------------------------------------------------
// Compile a Single .synchronix Unit -> .s -> .o and append to link_cmd
// ----------------------------------------------------------------------------
func sx_compile_unit(st: Int, idx: Int, append_link: Int) -> Int {
    let rel = sx_unit_src(idx)
    let stem = sx_unit_stem(idx)
    let root = bld_get(st, BST_ROOT())
    let bld = bld_get(st, BST_BLD())
    let sx_bin = bld_get(st, BST_SX())
    let cc_bin = bld_get(st, BST_CC())
    let cflags = bld_get(st, BST_CFLAGS())

    let src_p = sx_cstr_alloc(1024)
    sx_cstr_copy(src_p, root); sx_cstr_cat(src_p, "/"); sx_cstr_cat(src_p, rel)

    let out_base = sx_cstr_alloc(1024)
    sx_cstr_copy(out_base, bld); sx_cstr_cat(out_base, "/"); sx_cstr_cat(out_base, stem)

    let asm_p = sx_cstr_alloc(1024)
    sx_cstr_copy(asm_p, out_base); sx_cstr_cat(asm_p, ".s")

    let obj_p = sx_cstr_alloc(1024)
    sx_cstr_copy(obj_p, out_base); sx_cstr_cat(obj_p, ".o")

    // Step A: <SX> compile "<src>" --emit-asm -o "<out_base>"
    let cmd = sx_cstr_alloc(4096)
    sx_cstr_copy(cmd, sx_bin)
    sx_cstr_cat(cmd, " compile ")
    sx_cstr_cat_quoted(cmd, src_p)
    sx_cstr_cat(cmd, " --emit-asm -o ")
    sx_cstr_cat_quoted(cmd, out_base)
    let rc1 = system(cmd)

    if rc1 != 0 {
        print("ERROR: Failed compiling ")
        sx_println_str(rel)
        sx_cstr_free(src_p); sx_cstr_free(out_base); sx_cstr_free(asm_p); sx_cstr_free(obj_p); sx_cstr_free(cmd)
        return 1
    }

    // Step B: <CC> [CFLAGS] -c "<asm>" -o "<obj>"
    sx_cstr_copy(cmd, cc_bin)
    if sx_cstr_is_empty(cflags) == 0 {
        sx_cstr_cat(cmd, " "); sx_cstr_cat(cmd, cflags)
    }
    sx_cstr_cat(cmd, " -c ")
    sx_cstr_cat_quoted(cmd, asm_p)
    sx_cstr_cat(cmd, " -o ")
    sx_cstr_cat_quoted(cmd, obj_p)
    let rc2 = system(cmd)

    if rc2 != 0 {
        print("ERROR: Failed assembling ")
        sx_println_str(asm_p)
        sx_cstr_free(src_p); sx_cstr_free(out_base); sx_cstr_free(asm_p); sx_cstr_free(obj_p); sx_cstr_free(cmd)
        return 1
    }

    if append_link != 0 {
        let lcmd = bld_get(st, BST_LINK_CMD())
        sx_cstr_cat(lcmd, " ")
        sx_cstr_cat_quoted(lcmd, obj_p)
    }

    sx_cstr_free(src_p); sx_cstr_free(out_base); sx_cstr_free(asm_p); sx_cstr_free(obj_p); sx_cstr_free(cmd)
    return 0
}

// ----------------------------------------------------------------------------
// Cross-Target Verification: compile all 22 units for ARM64 & verify assembly
// ----------------------------------------------------------------------------
func sx_verify_unit_arm64(st: Int, idx: Int) -> Int {
    let rel = sx_unit_src(idx)
    let stem = sx_unit_stem(idx)
    let root = bld_get(st, BST_ROOT())
    let xver = bld_get(st, BST_XVER())
    let sx_bin = bld_get(st, BST_SX())

    let src_p = sx_cstr_alloc(1024)
    sx_cstr_copy(src_p, root); sx_cstr_cat(src_p, "/"); sx_cstr_cat(src_p, rel)

    let out_base = sx_cstr_alloc(1024)
    sx_cstr_copy(out_base, xver); sx_cstr_cat(out_base, "/"); sx_cstr_cat(out_base, stem)
    sx_cstr_cat(out_base, "_arm64")

    let cmd = sx_cstr_alloc(4096)
    sx_cstr_copy(cmd, sx_bin)
    sx_cstr_cat(cmd, " compile ")
    sx_cstr_cat_quoted(cmd, src_p)
    sx_cstr_cat(cmd, " --target arm64 -o ")
    sx_cstr_cat_quoted(cmd, out_base)

    let rc = system(cmd)
    if rc != 0 {
        print("ERROR: ARM64 cross-verify FAILED for ")
        sx_println_str(rel)
    }
    sx_cstr_free(src_p); sx_cstr_free(out_base); sx_cstr_free(cmd)
    return rc
}

// ----------------------------------------------------------------------------
// Native Clean (removes generated .s, .o, cross_verify/, synchronix.exe)
// ----------------------------------------------------------------------------
func sx_do_clean(st: Int) -> Int {
    let bld = bld_get(st, BST_BLD())
    let xver = bld_get(st, BST_XVER())
    let p = sx_cstr_alloc(1024)

    var i = 0
    while i < 22 {
        let stem = sx_unit_stem(i)
        sx_cstr_copy(p, bld); sx_cstr_cat(p, "/"); sx_cstr_cat(p, stem); sx_cstr_cat(p, ".s")
        sx_os_remove(p)
        sx_cstr_copy(p, bld); sx_cstr_cat(p, "/"); sx_cstr_cat(p, stem); sx_cstr_cat(p, ".o")
        sx_os_remove(p)
        sx_cstr_copy(p, xver); sx_cstr_cat(p, "/"); sx_cstr_cat(p, stem); sx_cstr_cat(p, "_arm64.s")
        sx_os_remove(p)
        sx_cstr_copy(p, xver); sx_cstr_cat(p, "/"); sx_cstr_cat(p, stem); sx_cstr_cat(p, "_arm64.o")
        sx_os_remove(p)
        i = i + 1
    }
    sx_os_rmdir(xver)

    print("[clean] Removed build artifacts from ")
    sx_println_str(bld)
    sx_cstr_free(p)
    return 0
}

// ----------------------------------------------------------------------------
// CLI Argument Parser (matching V1 build.S targets)
// ----------------------------------------------------------------------------
func sx_parse_build_args(argc: Int, argv: Int) -> Int {
    if argc < 2 {
        return ACT_RUNTIME() + ACT_COMPILER() + ACT_VERIFY()
    }
    var mask = 0
    var i = 1
    while i < argc {
        let a = sx_argv_get(argv, i)
        if sx_cstr_eq(a, "help") != 0 || sx_cstr_eq(a, "--help") != 0 || sx_cstr_eq(a, "-h") != 0 {
            mask = mask || ACT_HELP()
        } else {
            if sx_cstr_eq(a, "all") != 0 || sx_cstr_eq(a, "build") != 0 || sx_cstr_eq(a, "--no-verify") != 0 {
                mask = mask || ACT_RUNTIME() || ACT_COMPILER()
            } else {
                if sx_cstr_eq(a, "runtime") != 0 {
                    mask = mask || ACT_RUNTIME()
                } else {
                    if sx_cstr_eq(a, "compiler") != 0 {
                        mask = mask || ACT_COMPILER()
                    } else {
                        if sx_cstr_eq(a, "verify") != 0 {
                            mask = mask || ACT_RUNTIME() || ACT_COMPILER() || ACT_VERIFY()
                        } else {
                            if sx_cstr_eq(a, "clean") != 0 {
                                mask = mask || ACT_CLEAN()
                            } else {
                                print("ERROR: Unknown target/option: ")
                                sx_println_str(a)
                                return -1
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return mask
}

// ----------------------------------------------------------------------------
// Main Entry Point
// ----------------------------------------------------------------------------
func main(argc: Int, argv: Int) -> Int {
    let actions = sx_parse_build_args(argc, argv)
    if actions < 0 {
        return 1
    }
    if (actions && ACT_HELP()) != 0 {
        sx_build_help()
        return 0
    }

    let st = sx_closure_alloc(0, 16)
    let env_cc = sx_env_or_default("CC", "clang")
    let env_ar = sx_env_or_default("AR", "llvm-ar")
    let env_cf = sx_env_or_default("CFLAGS", "")
    let env_lf = sx_env_or_default("LDFLAGS", "-fuse-ld=lld")
    bld_set(st, BST_CC(),      env_cc)
    bld_set(st, BST_AR(),      env_ar)
    bld_set(st, BST_CFLAGS(),  env_cf)
    bld_set(st, BST_LDFLAGS(), env_lf)

    var argv0 = 0
    if argc >= 1 {
        argv0 = sx_argv_get(argv, 0)
    }
    sx_detect_root(st, argv0)
    let def_exe = bld_get(st, BST_EXE())
    let env_sx = sx_env_or_default("SX", def_exe)
    bld_set(st, BST_SX(), env_sx)

    if (actions && ACT_CLEAN()) != 0 {
        sx_do_clean(st)
    }
    if (actions && (ACT_RUNTIME() || ACT_COMPILER() || ACT_VERIFY())) == 0 {
        return 0
    }

    let bld_dir = bld_get(st, BST_BLD())
    sx_os_mkdir(bld_dir)

    // Prepare link command buffer
    let lcmd = sx_cstr_alloc(16384)
    let cc_b = bld_get(st, BST_CC())
    sx_cstr_copy(lcmd, cc_b)
    let ldf = bld_get(st, BST_LDFLAGS())
    if sx_cstr_is_empty(ldf) == 0 {
        sx_cstr_cat(lcmd, " "); sx_cstr_cat(lcmd, ldf)
    }
    bld_set(st, BST_LINK_CMD(), lcmd)

    if (actions && ACT_RUNTIME()) != 0 {
        println("[1/4] Compiling Synchronix v2 Runtime Units (Pure .synchronix)...")
        var r = 13
        while r <= 16 {
            let rrc = sx_compile_unit(st, r, 0)
            if rrc != 0 { return 1 }
            r = r + 1
        }
    }

    if (actions && ACT_COMPILER()) != 0 {
        println("[2/4] Compiling Synchronix v2 Compiler & Ecosystem Tooling (22 Pure .synchronix Units)...")
        var c = 0
        while c < 22 {
            let crc = sx_compile_unit(st, c, 1)
            if crc != 0 { return 1 }
            c = c + 1
        }

        println("[3/4] Linking synchronix_v2.exe with LLD...")
        let out_stage = sx_cstr_alloc(1024)
        sx_cstr_copy(out_stage, bld_dir)
        sx_cstr_cat(out_stage, "/synchronix_v2.exe")

        let rt_lib = bld_get(st, BST_RT())
        sx_cstr_cat(lcmd, " ")
        sx_cstr_cat_quoted(lcmd, rt_lib)
        sx_cstr_cat(lcmd, " -o ")
        sx_cstr_cat_quoted(lcmd, out_stage)

        let lrc = system(lcmd)
        if lrc != 0 {
            println("ERROR: Failed linking synchronix_v2.exe")
            return 1
        }
        print("SUCCESS! Built self-hosted compiler: ")
        sx_println_str(out_stage)
        sx_cstr_free(out_stage)
    }

    if (actions && ACT_VERIFY()) != 0 {
        println("[4/4] Cross-Verifying all 22 pure .synchronix units for ARM64 (AArch64)...")
        let xver_dir = bld_get(st, BST_XVER())
        sx_os_mkdir(xver_dir)
        var v = 0
        while v < 22 {
            let vrc = sx_verify_unit_arm64(st, v)
            if vrc != 0 { return 1 }
            v = v + 1
        }
        println("  [OK] All 22 pure .synchronix units compiled & assembled cleanly for ARM64 (aarch64-w64-windows-gnu)")
    }

    return 0
}
